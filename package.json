{
  "name": "horizon-cli",
  "version": "2.2.0",
  "description": "Seu ecossistema musical direto do terminal. Busca, baixa, organiza e envia músicas via CLI ou bot do Telegram. Compatível com Android (Termux), Linux, macOS e Windows.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "horizon": "index.js"
  },
  "files": [
    "index.js",
    "bot.js",
    "src/"
  ],
  "scripts": {
    "start": "node index.js",
    "bot": "node bot.js",
    "doctor": "node index.js doctor",
    "health": "node index.js health",
    "stats": "node index.js stats",
    "sync": "node index.js sync",
    "antiban": "node index.js antiban status",
    "backup": "node index.js backup",
    "setup": "chmod +x index.js && npm link"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cli",
    "music",
    "yt-dlp",
    "termux",
    "android",
    "telegram-bot",
    "playlist",
    "downloader"
  ],
  "author": "Horizon User",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "commander": "^11.1.0",
    "dotenv": "^17.4.0",
    "figlet": "^1.7.0",
    "inquirer": "^9.2.12",
    "nanospinner": "^1.1.0",
    "telegraf": "^4.16.3"
  }
}
