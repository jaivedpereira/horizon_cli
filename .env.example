# ============================================================
#  HORIZON BOT — Variáveis de ambiente
# ============================================================
# Copie este arquivo para `.env` e preencha os valores.

# Token do bot do Telegram (obtenha no @BotFather).
BOT_TOKEN=coloque_seu_token_aqui

# (Opcional) IDs permitidos, separados por vírgula. Se vazio, o bot
# aceita qualquer usuário. Obtenha seu ID no @userinfobot.
# Exemplo: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# (Opcional) Tempo mínimo (ms) entre mensagens do mesmo usuário.
RATE_LIMIT_MS=1500
