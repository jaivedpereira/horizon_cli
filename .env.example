# ============================================================
#  HORIZON BOT — Variáveis de ambiente
# ============================================================
# Copie este arquivo para `.env` e preencha os valores.

# === OBRIGATÓRIO ===
# Token do bot do Telegram (obtenha no @BotFather).
BOT_TOKEN=coloque_seu_token_aqui

# === ACESSO ===
# (Opcional) IDs permitidos, separados por vírgula. Se vazio, o bot
# aceita qualquer usuário. Obtenha seu ID no @userinfobot.
# Exemplo: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# (Opcional) IDs de admins, separados por vírgula. Admins têm acesso a:
# /admin_users, /admin_block, /admin_unblock, /admin_broadcast.
# Admins também ignoram a quota diária.
ADMIN_USER_IDS=

# === LIMITES ===
# Quantos downloads cada usuário pode pedir por dia (reset à meia-noite UTC).
DAILY_QUOTA=30

# Quantos downloads simultâneos o servidor processa no MÁXIMO (anti-ban).
MAX_CONCURRENT_DOWNLOADS=2

# Limite máximo de faixas que o bot baixa de uma playlist por vez.
PLAYLIST_MAX_TRACKS=100

# Tempo mínimo (ms) entre mensagens do mesmo usuário (anti-flood).
RATE_LIMIT_MS=1500

# === MANUTENÇÃO ===
# Se "1", o bot atualiza o yt-dlp automaticamente ao iniciar.
# Recomendado para servidor 24/7.
AUTO_UPDATE_YTDLP=1
